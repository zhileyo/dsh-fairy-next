{
  "name": "dsh-fairy-next-voice",
  "version": "1.0.0",
  "description": "Fairy voice: local TTS playback for assistant replies through an external local TTS runtime.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "dsh-fairy-next-contracts": "^0.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tts",
    "voice",
    "gpt-sovits",
    "index-tts"
  ],
  "author": "zhileyo",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zhileyo/dsh-fairy-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhileyo/dsh-fairy-next.git",
    "directory": "packages/dsh-fairy-next-voice"
  },
  "bugs": {
    "url": "https://github.com/zhileyo/dsh-fairy-next/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
