{
  "name": "dsh-fairy-dock",
  "version": "0.1.5",
  "description": "Browser dock: an in-app browser surface plus the Playwright proxy it drives.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "dsh-fairy-contracts": "^0.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib",
    "proxy.cjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "browser",
    "playwright",
    "dock"
  ],
  "author": "zhileyo",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zhileyo/dsh-fairy-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhileyo/dsh-fairy-next.git",
    "directory": "packages/dsh-fairy-dock"
  },
  "bugs": {
    "url": "https://github.com/zhileyo/dsh-fairy-next/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
