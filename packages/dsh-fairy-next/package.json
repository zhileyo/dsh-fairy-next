{
  "name": "dsh-fairy-next",
  "version": "0.1.5",
  "description": "Fairy theme suite anchor: one install, one skin.json, one bundle patch that wires the Fairy plugins into a DSH profile.",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-fairy-contracts": "^0.1.5",
    "dsh-fairy-visual": "^0.1.5",
    "dsh-fairy-startup": "^0.1.5",
    "dsh-fairy-balance": "^0.1.5",
    "dsh-fairy-speech": "^0.1.5",
    "dsh-fairy-dock": "^0.1.5"
  },
  "bundleDependencies": [
    "dsh-fairy-contracts",
    "dsh-fairy-visual",
    "dsh-fairy-startup",
    "dsh-fairy-balance",
    "dsh-fairy-speech",
    "dsh-fairy-dock"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "fairy",
    "zenless-zone-zero",
    "hdd",
    "skin"
  ],
  "author": "zhileyo",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zhileyo/dsh-fairy-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhileyo/dsh-fairy-next.git",
    "directory": "packages/dsh-fairy-next"
  },
  "bugs": {
    "url": "https://github.com/zhileyo/dsh-fairy-next/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
