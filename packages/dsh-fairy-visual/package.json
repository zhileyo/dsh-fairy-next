{
  "name": "dsh-fairy-visual",
  "version": "0.1.1",
  "description": "Fairy visual presentation for DSH: HDD theme, big-eye stage, composer dock and semantic marker system.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "dsh-fairy-contracts": "^0.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib",
    "src",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "fairy",
    "hdd",
    "zenless-zone-zero"
  ],
  "author": "zhileyo",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zhileyo/dsh-fairy-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhileyo/dsh-fairy-next.git",
    "directory": "packages/dsh-fairy-visual"
  },
  "bugs": {
    "url": "https://github.com/zhileyo/dsh-fairy-next/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "bundle": "node ../../tools/build-client.mjs ."
  }
}
